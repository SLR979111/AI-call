# Local / demo settings (copy the values you need into .env).
# .env.example is protected by the agent's credential policy in this workspace;
# this file is the human-readable copy for cx.
APP_BASE=http://127.0.0.1:8081
APP_ENV=dev
RELEASE_ID=rel_dev_001
DATA_DIR=./data
DEV_NO_AUTH=1

# ---------------------------------------------------------------------------
# LLM Provider Configuration (OpenAI-compatible APIs)
# Set AGENT_PROVIDER=llm to enable real LLM agent; fake for rule-based agent
# ---------------------------------------------------------------------------
AGENT_PROVIDER=fake

# Primary LLM Provider (required when AGENT_PROVIDER=llm)
LLM_PRIMARY_BASE_URL=https://api.deepseek.com/v1
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=deepseek-chat
LLM_PRIMARY_NAME=deepseek

# Secondary LLM Provider (optional fallback)
LLM_SECONDARY_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_SECONDARY_API_KEY=
LLM_SECONDARY_MODEL=qwen-plus
LLM_SECONDARY_NAME=qwen

# LLM Configuration
LLM_TIMEOUT_MS=3000
LLM_PRICE_PER_1K_CNY=0.002
LLM_DAILY_BUDGET_CNY=100

# Voice / media (optional; unset -> fake voice + ws_pcm)
VOICE_PROVIDER=fake
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
