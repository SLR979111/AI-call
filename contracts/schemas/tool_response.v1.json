{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aicall.local/contracts/schemas/tool_response.v1.json",
  "title": "ToolResponse v1.0",
  "description": "ToolResult returned by the Tool Gateway: ok=true carries data, ok=false carries an AppError.",
  "type": "object",
  "required": ["ok", "meta"],
  "properties": {
    "ok": { "type": "boolean" },
    "data": { "type": "object", "additionalProperties": true },
    "meta": {
      "type": "object",
      "properties": {
        "attempt": { "type": "integer", "minimum": 1 },
        "cached": { "type": "boolean" },
        "latency_ms": { "type": "number", "minimum": 0 },
        "tool_version": { "type": "string" }
      },
      "additionalProperties": true
    },
    "error": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "TOOL_TIMEOUT",
            "TOOL_5XX",
            "TOOL_INVALID_ARGS",
            "TOOL_NOT_FOUND",
            "TOOL_PERMISSION_DENIED",
            "TOOL_RATE_LIMIT"
          ]
        },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" },
        "severity": { "type": "string", "enum": ["info", "warn", "error", "fatal"] },
        "user_message": { "type": "string" },
        "fallback": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": { "properties": { "ok": { "const": true } }, "required": ["ok"] },
      "then": { "required": ["data"] }
    },
    {
      "if": { "properties": { "ok": { "const": false } }, "required": ["ok"] },
      "then": { "required": ["error"] }
    }
  ]
}
