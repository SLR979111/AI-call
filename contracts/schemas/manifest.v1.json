{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aicall.local/contracts/schemas/manifest.v1.json",
  "title": "Version Manifest v1.0",
  "description": "Version Registry manifest (interface E).",
  "type": "object",
  "required": ["release_id", "status", "artifacts", "metrics", "created_at"],
  "properties": {
    "release_id": { "type": "string", "minLength": 1, "pattern": "^rel_[A-Za-z0-9_]+$" },
    "status": { "type": "string", "enum": ["candidate", "production", "previous", "archived"] },
    "artifacts": { "type": "object", "additionalProperties": true },
    "metrics": { "type": "object", "additionalProperties": true },
    "created_at": { "type": "string", "format": "date-time" },
    "parent_release_id": { "type": ["string", "null"] },
    "notes": { "type": "string" }
  },
  "additionalProperties": true
}
