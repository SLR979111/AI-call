# Copy this file to .env for `docker compose up` (Compose loads it
# automatically). For a local `uvicorn` run, export variables in your shell
# instead; uvicorn does not read .env on its own.
# Never commit .env (it is gitignored).

# Runtime profile: dev | staging | prod.
APP_ENV=dev

# Release identifier pinned by every session/event (docs/04 event envelope).
RELEASE_ID=rel_dev_001

# SQLite / JSONL / generated artifacts. "./data" maps to /app/data in Docker.
DATA_DIR=./data

# Dev-only flag reserved for the auth layer. The fake skeleton does not
# enforce auth, so curl / scripts/smoke.sh work without a token. Must be 0
# (with a real auth path configured) before any non-demo deployment.
DEV_NO_AUTH=1

# ---------------------------------------------------------------------------
# LLM Provider Configuration (OpenAI-compatible APIs)
# Set AGENT_PROVIDER=llm to enable real LLM agent; fake for rule-based agent
# ---------------------------------------------------------------------------
AGENT_PROVIDER=fake

# Primary LLM Provider (required when AGENT_PROVIDER=llm)
LLM_PRIMARY_BASE_URL=https://api.deepseek.com/v1
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=deepseek-chat
LLM_PRIMARY_NAME=deepseek

# Secondary LLM Provider (optional fallback)
LLM_SECONDARY_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_SECONDARY_API_KEY=
LLM_SECONDARY_MODEL=qwen-plus
LLM_SECONDARY_NAME=qwen

# LLM Configuration
LLM_TIMEOUT_MS=3000
LLM_PRICE_PER_1K_CNY=0.002
LLM_DAILY_BUDGET_CNY=100
