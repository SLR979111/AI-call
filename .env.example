# Copy this file to .env for `docker compose up` (Compose loads it
# automatically). For a local `uvicorn` run, export variables in your shell
# instead; uvicorn does not read .env on its own.
# Never commit .env (it is gitignored).

# Runtime profile: dev | staging | prod.
APP_ENV=dev

# Release identifier pinned by every session/event (docs/04 event envelope).
RELEASE_ID=rel_dev_001

# SQLite / JSONL / generated artifacts. "./data" maps to /app/data in Docker.
DATA_DIR=./data

# Dev-only flag reserved for the auth layer. The fake skeleton does not
# enforce auth, so curl / scripts/smoke.sh work without a token. Must be 0
# (with a real auth path configured) before any non-demo deployment.
DEV_NO_AUTH=1

# ---------------------------------------------------------------------------
# Cloud LLM (Volcengine Ark / OpenAI-compatible). Fill the key locally; never
# commit .env. Uncomment AGENT_PROVIDER to switch 84 from rule to LLM.
# ---------------------------------------------------------------------------
# AGENT_PROVIDER=llm
# LLM_PRIMARY_NAME=volcengine
# LLM_PRIMARY_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_PRIMARY_API_KEY=
# LLM_PRIMARY_MODEL=doubao-seed-2-0-lite-260428
# LLM_PRIMARY_THINKING=disabled
# LLM_TIMEOUT_MS=5000
# LLM_STREAM_MODE=reply
# dynamic: only expose callback.create on callback/transfer intent; none = no tools.
LLM_TOOL_ALLOWLIST=dynamic
LLM_MAX_TOKENS=160
LLM_PLAIN_MAX_TOKENS=96
LLM_MAX_REPLY_CHARS=50
# Ordinary turns stream plain text; JSON only for tool intents.
LLM_PLAIN_REPLY=1
# Phase-aware fillers. They are spoken before the full LLM answer.
LLM_FILLER_IDENTITY=好的，我明白了。
LLM_FILLER_CONFIRM=好的，我帮您确认一下。
LLM_FILLER_OFFER=好的，我帮您看一下这笔申请。
LLM_FILLER_RESULT=好的，我帮您确认处理结果。
LLM_FILLER_DEFAULT=好的，我收到您的信息了。
LLM_STAGE_WAIT=亲，请您稍等。

# Voice production defaults. See docs/guides/production-voice.md.
ASR_PROVIDER=sherpa
ASR_NUM_THREADS=4
ASR_ENDPOINT_SILENCE_S=0.8
# Volcengine streaming ASR (bigmodel_async, 16k PCM).
VOLC_ASR_API_KEY=
VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
VOLC_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
VOLC_ASR_END_WINDOW_MS=800
TTS_PROVIDER=qwen3
TTS_FALLBACK_PROVIDER=
# hybrid: local phase fillers + Volc Seed-TTS for real answers.
HYBRID_FILLER_DIR=./data/voice/fillers-volc
# Volcengine Seed-TTS 2.0 unidirectional WebSocket.
VOLC_TTS_API_KEY=
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_SPEAKER=zh_female_vv_uranus_bigtts
VOLC_TTS_ENDPOINT=wss://openspeech.bytedance.com/api/v3/tts/unidirectional/stream
VOLC_TTS_BIDIRECTIONAL_ENDPOINT=wss://openspeech.bytedance.com/api/v3/tts/bidirection
# Pre-rendered fixed filler for sub-second first audio (Melo path).
MELO_FILLER_TEXT=好的，我帮您看一下这笔申请。
MELO_FILLER_AUDIO=./data/voice/filler.wav
# Business integration. mock = local MockBusiness; real = HTTP BusinessGateway.
# Real mode requires both API URL and key, otherwise the app refuses to start.
BUSINESS_GATEWAY=mock
BUSINESS_API_BASE_URL=
BUSINESS_API_KEY=
BUSINESS_TIMEOUT_MS=5000
BUSINESS_RETRY_COUNT=0
# Write tools (callback.create / ticket.create / order.reschedule) are never
# auto-retried; real gateway sends Idempotency-Key for callback creates.
ASR_MODEL_HOST_DIR=./models/asr
MELO_MODEL_HOST_DIR=./models/melo
QWEN_MODEL_HOST_DIR=./models/qwen
QWEN_VOICE_HOST_DIR=./data/voice
QWEN_REF_TEXT=
QWEN_REFERENCE_CONSENT=0
QWEN_GROUP_SENTENCES=3
# Sidecar generation defaults match the selected audition; overrides require re-audition.
QWEN_CHUNK_SIZE=4
QWEN_NON_STREAMING_MODE=false
QWEN_TEMPERATURE=0.9
QWEN_TOP_K=50
QWEN_TOP_P=1.0
QWEN_MAX_NEW_TOKENS=2048
QWEN_INSTRUCT=用自然、平稳、亲切的客服语气，语速适中，句间停顿自然，不要夸张。
QWEN_TTS_TIMEOUT_S=30
