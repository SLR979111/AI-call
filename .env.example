DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-flash
DEEPSEEK_TTS_VOICE=stella
# Predictions are optional. The direct response path always works independently.
PREDICTION_ENABLED=1
# Parallel forecast branches (1-5). More branches widen cache coverage.
PREDICTION_BRANCHES=5
# Optional cloud selector for ambiguous lexical decisions.
DECISION_ENABLED=0
DECISION_TIMEOUT_MS=900
# Optionally reject forecasts containing unsupported promises before preparing audio.
PREDICTION_FILTER_PROMISES=0
# Experimental audio budget for forecast candidates. Unset/empty = prepare
# audio for every candidate (production default). N = only the first N
# candidates get prepared audio; later candidates are still exposed as text
# and fall back to ordinary TTS if selected. 0 disables forecast audio.
PREDICTION_AUDIO_LIMIT=
# Shared SQLite cache for LLM/ASR/TTS and opening forecasts.
CACHE_PATH=./runtime/cache.sqlite3
# Optional cache audit for rebuilding the SQLite cache after loss.
# Contains conversation text; do not commit. Leave empty to disable.
CACHE_AUDIT_PATH=
PORT=8088

# Local SenseVoice ASR for the final transcript (~0.2 s instead of the ~0.7 s
# cloud round trip). Set LOCAL_ASR=0 to use the cloud endpoint only.
LOCAL_ASR=1
LOCAL_ASR_DIR=./models/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-2024-07-17
LOCAL_ASR_THREADS=2
# Endpointing: silence before committing a voice turn (ms).
HEARING_DEFER_MS=480
HEARING_DEFER_SHORT_MS=260
HEARING_DEFER_QUESTION_MS=340

# Cache only the first sentence of the opening before cloud calls. Set 0 to skip.
TASK_PREWARM_ON_LOAD=1

# Semantic tie-breaker for forecast reuse. The lexical rules stay the fast
# path; this only runs where they would otherwise send the turn to the model,
# and it can only rescue a short answer to a question just asked.
# Set 0 to disable. The model directory must exist; otherwise it is skipped.
SEMANTIC_DECISION=0
SEMANTIC_MODEL_DIR=./models/bge-small-zh-v1.5
SEMANTIC_DECISION_THRESHOLD=0.72
SEMANTIC_DECISION_MARGIN=0.05
SEMANTIC_DECISION_TIMEOUT_MS=120
