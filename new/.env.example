DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-flash
DEEPSEEK_TTS_VOICE=stella
# Predictions are optional. The direct response path always works independently.
PREDICTION_ENABLED=1
# Parallel forecast branches (1-5). More branches widen cache coverage.
PREDICTION_BRANCHES=5
# Shared SQLite cache for LLM/ASR/TTS and opening forecasts.
CACHE_PATH=./runtime/cache.sqlite3
PORT=8088

# Local SenseVoice ASR for the final transcript (~0.2 s instead of the ~0.7 s
# cloud round trip). Set LOCAL_ASR=0 to use the cloud endpoint only.
LOCAL_ASR=1
LOCAL_ASR_DIR=../models/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-2024-07-17
LOCAL_ASR_THREADS=4
# Endpointing: silence before committing a voice turn (ms).
HEARING_DEFER_MS=480
HEARING_DEFER_SHORT_MS=260
HEARING_DEFER_QUESTION_MS=340

# Warm model/TTS caches with synthetic conversations after task load.
# Nothing is sent to the browser. Set 0 to disable.
TASK_PREWARM_ON_LOAD=1
TASK_PREWARM_CONCURRENCY=4
TASK_PREWARM_LOOP_DELAY=1
TASK_PREWARM_MAX_ROUNDS=0
