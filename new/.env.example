DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-flash
DEEPSEEK_TTS_VOICE=stella
# Predictions are optional. The direct response path always works independently.
PREDICTION_ENABLED=1
# Parallel forecast branches (1-5). More branches widen cache coverage.
PREDICTION_BRANCHES=5
# Experimental audio budget for forecast candidates. Text is published as
# soon as it arrives; this only limits background audio preparation.
# Unset/empty = prepare audio for every candidate (production default).
# N = only the first N candidates get prepared audio; later candidates are
# still exposed as text and fall back to ordinary TTS if selected.
# 0 disables forecast audio.
PREDICTION_AUDIO_LIMIT=
# Short decision-model request after lexical rules are unsure.
DECISION_ENABLED=1
DECISION_TIMEOUT_MS=900
# Shared SQLite cache for LLM/ASR/TTS and opening forecasts.
CACHE_PATH=./runtime/cache.sqlite3
# Optional cache audit. When set, the provider boundary writes enough data
# (full messages, response, raw PCM) for scripts/backfill_cache.py to rebuild
# a lost SQLite cache. Leave empty to disable.
CACHE_AUDIT_PATH=
PORT=8088

# Local SenseVoice ASR for the final transcript (~0.2 s instead of the ~0.7 s
# cloud round trip). Set LOCAL_ASR=0 to use the cloud endpoint only.
LOCAL_ASR=1
LOCAL_ASR_DIR=../models/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-2024-07-17
LOCAL_ASR_THREADS=4
# Endpointing: silence before committing a voice turn (ms).
HEARING_DEFER_MS=480
HEARING_DEFER_SHORT_MS=260
HEARING_DEFER_QUESTION_MS=340
